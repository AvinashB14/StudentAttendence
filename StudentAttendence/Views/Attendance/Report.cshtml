@model StudentAttendence.Models.AttendanceReportViewModel
@{
    ViewBag.Title = "Attendance Reports";
    bool isStudentWise = Model.ReportType == "StudentWise";
}

<style>
    .custom-date-picker {
        background: #0f0f1a !important;
        color: #e2e8f0 !important;
        border: 1px solid var(--border) !important;
        border-radius: 10px;
        padding: .75rem 1rem;
        font-family: 'Inter', sans-serif;
        font-size: .95rem;
        color-scheme: dark;
        transition: border-color .2s, box-shadow .2s;
        cursor: pointer;
    }
    .custom-date-picker:focus {
        border-color: #0ea5e9 !important;
        box-shadow: 0 0 0 3px rgba(14, 165, 233, .2) !important;
    }
    .custom-date-picker::-webkit-calendar-picker-indicator {
        filter: invert(0.8) sepia(1) saturate(5) hue-rotate(160deg);
        cursor: pointer;
        opacity: 0.85;
        transition: opacity .2s, transform .2s;
    }
    .custom-date-picker::-webkit-calendar-picker-indicator:hover {
        opacity: 1;
        transform: scale(1.1);
    }
</style>

<div style="max-width: 960px; margin: 0 auto;">

    <!-- Page Header -->
    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem; margin-bottom:1.75rem;">
        <div>
            <h1 style="font-size:1.75rem; font-weight:800; margin-bottom:.3rem;
                       background:linear-gradient(135deg,#38bdf8,#a78bfa);
                       -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">
                Attendance Analytics &amp; Reports
            </h1>
            <p style="color:#94a3b8; font-size:.9rem;">
                Detailed percentage summaries by student or by class date
            </p>
        </div>
        <a href="@Url.Action("Mark","Attendance")" class="btn btn-secondary btn-sm" style="padding:.6rem 1.2rem;">
            &#128247; Mark Attendance
        </a>
    </div>

    <!-- Report Type Switcher Tabs -->
    <div style="display:flex; gap:10px; margin-bottom:1.5rem; background:#16213e; padding:6px; border-radius:12px; border:1px solid rgba(255,255,255,.08); max-width:540px;">
        <a href="@Url.Action("Report", "Attendance", new { reportType = "StudentWise" })"
           style="flex:1; text-align:center; padding:10px 14px; border-radius:8px; font-weight:600; font-size:.9rem; text-decoration:none; transition:all .2s;
                  @(isStudentWise ? "background:#6c63ff; color:#fff; box-shadow:0 4px 14px rgba(108,99,255,.4);" : "color:#94a3b8;")">
            &#128100; 1. Student Monthly %
        </a>
        <a href="@Url.Action("Report", "Attendance", new { reportType = "ClassDayWise" })"
           style="flex:1; text-align:center; padding:10px 14px; border-radius:8px; font-weight:600; font-size:.9rem; text-decoration:none; transition:all .2s;
                  @(!isStudentWise ? "background:#0ea5e9; color:#fff; box-shadow:0 4px 14px rgba(14,165,233,.4);" : "color:#94a3b8;")">
            &#127979; 2. Class Day-Wise %
        </a>
    </div>

    
    <!-- TAB 1: PARTICULAR STUDENT MONTHLY PERCENTAGE REPORT         -->
    
    @if (isStudentWise)
    {
        <div class="card" style="padding:1.4rem; margin-bottom:1.75rem;">
            <div style="font-weight:700; font-size:1.05rem; margin-bottom:1rem; color:#e2e8f0; display:flex; align-items:center; gap:8px;">
                <span>&#128269;</span> Filter Student &amp; Month
            </div>

            @using (Html.BeginForm("Report", "Attendance", FormMethod.Get, new { style = "display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)) 120px; gap:12px; align-items:end;" }))
            {
                <input type="hidden" name="reportType" value="StudentWise" />

                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Select Student</label>
                    <select name="studentId" class="form-control" style="background:#0f0f1a;">
                        @foreach (var s in Model.AllStudents)
                        {
                            <option value="@s.StudentId" @(Model.SelectedStudentId == s.StudentId ? "selected" : "")>
                                @s.FullName (@s.PRN) - @s.Department
                            </option>
                        }
                    </select>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Select Month</label>
                    <select name="month" class="form-control" style="background:#0f0f1a;">
                        @for (int m = 1; m <= 12; m++)
                        {
                            var monthText = new DateTime(2026, m, 1).ToString("MMMM");
                            <option value="@m" @(Model.SelectedMonth == m ? "selected" : "")>@monthText</option>
                        }
                    </select>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Select Year</label>
                    <select name="year" class="form-control" style="background:#0f0f1a;">
                        @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 4; y--)
                        {
                            <option value="@y" @(Model.SelectedYear == y ? "selected" : "")>@y</option>
                        }
                    </select>
                </div>

                <div>
                    <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center; padding:.75rem;">
                        Filter
                    </button>
                </div>
            }
        </div>

        if (Model.StudentSummary != null)
        {
            var summary = Model.StudentSummary;
            <div class="card" style="padding:1.5rem; margin-bottom:1.5rem; border-color:rgba(108,99,255,.3);">
                <!-- Student Details & Profile -->
                <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1.25rem; margin-bottom:1.5rem; padding-bottom:1.25rem; border-bottom:1px solid rgba(255,255,255,.08);">
                    <div style="display:flex; align-items:center; gap:16px;">
                        @if (!string.IsNullOrEmpty(summary.Student.PhotoBase64))
                        {
                            <img src="data:image/jpeg;base64,@summary.Student.PhotoBase64" alt="@summary.Student.FullName"
                                 style="width:72px; height:72px; border-radius:50%; object-fit:cover; border:3px solid #6c63ff;" />
                        }
                        else
                        {
                            <div style="width:72px; height:72px; border-radius:50%; background:rgba(108,99,255,.2); display:flex; align-items:center; justify-content:center; font-size:2rem; color:#a78bfa;">
                                &#128100;
                            </div>
                        }
                        <div>
                            <h2 style="font-size:1.35rem; font-weight:800; color:#fff; margin-bottom:.25rem;">@summary.Student.FullName</h2>
                            <div style="display:flex; gap:8px; flex-wrap:wrap; font-size:.85rem; color:#94a3b8;">
                                <span class="badge badge-primary">Roll No: @summary.Student.PRN</span>
                                <span>@summary.Student.Department</span>
                                <span>&bull;</span>
                                <span>Year @summary.Student.Year</span>
                            </div>
                        </div>
                    </div>
                    <div style="text-align:right;">
                        <span style="font-size:.85rem; color:#94a3b8;">Month Report</span>
                        <div style="font-size:1.2rem; font-weight:700; color:#38bdf8;">@summary.MonthName</div>
                    </div>
                </div>

                <!-- Percentage & Stat Cards -->
                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:1rem; margin-bottom:1.75rem;">
                    <!-- Present Percentage -->
                    <div style="background:rgba(34,197,94,.1); border:1px solid rgba(34,197,94,.3); border-radius:12px; padding:1.2rem; text-align:center;">
                        <div style="font-size:.8rem; text-transform:uppercase; letter-spacing:.05em; color:#86efac; font-weight:600; margin-bottom:.3rem;">
                            Present Percentage
                        </div>
                        <div style="font-size:2.2rem; font-weight:900; color:#4ade80;">
                            @summary.PresentPercentage%
                        </div>
                        <div style="font-size:.8rem; color:#94a3b8; margin-top:.2rem;">
                            @summary.PresentDays / @summary.TotalWorkingDays Days
                        </div>
                    </div>

                    <!-- Absent Percentage -->
                    <div style="background:rgba(239,68,68,.1); border:1px solid rgba(239,68,68,.3); border-radius:12px; padding:1.2rem; text-align:center;">
                        <div style="font-size:.8rem; text-transform:uppercase; letter-spacing:.05em; color:#fca5a5; font-weight:600; margin-bottom:.3rem;">
                            Absent Percentage
                        </div>
                        <div style="font-size:2.2rem; font-weight:900; color:#f87171;">
                            @summary.AbsentPercentage%
                        </div>
                        <div style="font-size:.8rem; color:#94a3b8; margin-top:.2rem;">
                            @summary.AbsentDays / @summary.TotalWorkingDays Days
                        </div>
                    </div>

                    <!-- Total Working Days -->
                    <div style="background:#16213e; border:1px solid rgba(255,255,255,.08); border-radius:12px; padding:1.2rem; text-align:center;">
                        <div style="font-size:.8rem; text-transform:uppercase; letter-spacing:.05em; color:#94a3b8; font-weight:600; margin-bottom:.3rem;">
                            Working Days
                        </div>
                        <div style="font-size:2.2rem; font-weight:900; color:#e2e8f0;">
                            @summary.TotalWorkingDays
                        </div>
                        <div style="font-size:.8rem; color:#64748b; margin-top:.2rem;">
                            Excluding Sundays
                        </div>
                    </div>
                </div>

                <!-- Progress Bar -->
                <div style="margin-bottom:1.75rem;">
                    <div style="display:flex; justify-content:space-between; font-size:.82rem; color:#94a3b8; margin-bottom:.4rem;">
                        <span>Monthly Attendance Distribution</span>
                        <span><strong>@summary.PresentPercentage%</strong> Present</span>
                    </div>
                    <div style="height:14px; border-radius:999px; background:rgba(239,68,68,.3); overflow:hidden; display:flex;">
                        <div style="width:@summary.PresentPercentage%; background:linear-gradient(90deg, #22c55e, #4ade80); border-radius:999px 0 0 999px;"></div>
                    </div>
                </div>

                <!-- Day-by-Day Breakdown Table -->
                <div style="font-weight:700; font-size:1rem; margin-bottom:.85rem; color:#e2e8f0;">
                    Daily Attendance Log (@summary.MonthName)
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Day</th>
                                <th>Status</th>
                                <th>Marked Time</th>
                                <th>Subject</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in summary.DailyBreakdown)
                            {
                                <tr>
                                    <td style="font-weight:600;">@d.Date.ToString("dd MMMM yyyy")</td>
                                    <td style="color:#94a3b8;">@d.Date.ToString("dddd")</td>
                                    <td>
                                        @if (d.IsPresent)
                                        {
                                            <span class="badge badge-success">&#10004; Present</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background:rgba(239,68,68,.15); color:#f87171;">&#10007; Absent</span>
                                        }
                                    </td>
                                    <td style="color:#94a3b8;">@(string.IsNullOrEmpty(d.Time) || d.Time == "—" ? "-" : d.Time)</td>
                                    <td style="color:#94a3b8;">@(string.IsNullOrWhiteSpace(d.Subject) || d.Subject == "—" ? "-" : d.Subject)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="card" style="text-align:center; padding:3rem; color:#94a3b8;">
                <p>No student selected or registered yet.</p>
            </div>
        }
    }
    <!-- TAB 2: PARTICULAR CLASS DAY-WISE ATTENDANCE REPORT          -->
    @if (!isStudentWise)
    {
        <div class="card" style="padding:1.4rem; margin-bottom:1.75rem;">
            <div style="font-weight:700; font-size:1.05rem; margin-bottom:1rem; color:#e2e8f0; display:flex; align-items:center; gap:8px;">
                <span>&#128269;</span> Filter Class &amp; Date
            </div>

            @using (Html.BeginForm("Report", "Attendance", FormMethod.Get, new { style = "display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)) 120px; gap:12px; align-items:end;" }))
            {
                <input type="hidden" name="reportType" value="ClassDayWise" />

                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Department</label>
                    <select name="department" class="form-control" style="background:#0f0f1a;">
                        <option value="">All Departments</option>
                        @foreach (var d in Model.Departments)
                        {
                            <option value="@d" @(Model.SelectedDepartment == d ? "selected" : "")>@d</option>
                        }
                    </select>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Class Year</label>
                    <select name="classYear" class="form-control" style="background:#0f0f1a;">
                        <option value="">All Years</option>
                        @foreach (var y in Model.ClassYears)
                        {
                            <option value="@y" @(Model.SelectedClassYear == y ? "selected" : "")>Year @y</option>
                        }
                    </select>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Date</label>
                    <input type="date" name="date" class="form-control custom-date-picker"
                           value="@Model.SelectedDate.ToString("yyyy-MM-dd")"/>
                </div>

                <div>
                    <button type="submit" class="btn btn-secondary" style="width:100%; justify-content:center; padding:.75rem;">
                        Filter
                    </button>
                </div>
            }
        </div>

        if (Model.ClassSummary != null)
        {
            var cSummary = Model.ClassSummary;
            <div class="card" style="padding:1.5rem; margin-bottom:1.5rem; border-color:rgba(14,165,233,.3);">
                <!-- Header with Class info and date -->
                <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem; margin-bottom:1.5rem; padding-bottom:1.25rem; border-bottom:1px solid rgba(255,255,255,.08);">
                    <div>
                        <h2 style="font-size:1.35rem; font-weight:800; color:#fff; margin-bottom:.3rem;">
                            @(string.IsNullOrEmpty(cSummary.Department) ? "All Departments" : cSummary.Department)
                            @(cSummary.ClassYear.HasValue ? " - Year " + cSummary.ClassYear.Value : "")
                        </h2>
                        <div style="color:#94a3b8; font-size:.875rem;">
                            Daily Attendance Report for <strong>@cSummary.Date.ToString("dddd, dd MMMM yyyy")</strong>
                        </div>
                    </div>
                    <div>
                        <span class="badge badge-primary" style="font-size:.85rem; padding:.4rem .9rem;">
                            @cSummary.TotalStudents Enrolled Students
                        </span>
                    </div>
                </div>

                <!-- 4 Percentage & Stat Cards -->
                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:1rem; margin-bottom:1.75rem;">
                    <!-- Total Students -->
                    <div style="background:#16213e; border:1px solid rgba(255,255,255,.08); border-radius:12px; padding:1.2rem; text-align:center;">
                        <div style="font-size:.8rem; text-transform:uppercase; letter-spacing:.05em; color:#94a3b8; font-weight:600; margin-bottom:.3rem;">
                            Total Students
                        </div>
                        <div style="font-size:2.2rem; font-weight:900; color:#e2e8f0;">
                            @cSummary.TotalStudents
                        </div>
                        <div style="font-size:.8rem; color:#64748b; margin-top:.2rem;">
                            Enrolled in Class
                        </div>
                    </div>

                    <!-- Present Students & Percentage -->
                    <div style="background:rgba(34,197,94,.1); border:1px solid rgba(34,197,94,.3); border-radius:12px; padding:1.2rem; text-align:center;">
                        <div style="font-size:.8rem; text-transform:uppercase; letter-spacing:.05em; color:#86efac; font-weight:600; margin-bottom:.3rem;">
                            Present (%)
                        </div>
                        <div style="font-size:2.2rem; font-weight:900; color:#4ade80;">
                            @cSummary.PresentPercentage%
                        </div>
                        <div style="font-size:.85rem; font-weight:700; color:#86efac; margin-top:.2rem;">
                            @cSummary.PresentCount Present
                        </div>
                    </div>

                    <!-- Absent Students & Percentage -->
                    <div style="background:rgba(239,68,68,.1); border:1px solid rgba(239,68,68,.3); border-radius:12px; padding:1.2rem; text-align:center;">
                        <div style="font-size:.8rem; text-transform:uppercase; letter-spacing:.05em; color:#fca5a5; font-weight:600; margin-bottom:.3rem;">
                            Absent (%)
                        </div>
                        <div style="font-size:2.2rem; font-weight:900; color:#f87171;">
                            @cSummary.AbsentPercentage%
                        </div>
                        <div style="font-size:.85rem; font-weight:700; color:#fca5a5; margin-top:.2rem;">
                            @cSummary.AbsentCount Absent
                        </div>
                    </div>
                </div>

                <!-- Class Percentage Visual Bar -->
                <div style="margin-bottom:1.75rem;">
                    <div style="display:flex; justify-content:space-between; font-size:.82rem; color:#94a3b8; margin-bottom:.4rem;">
                        <span>Class Attendance Ratio</span>
                        <span>
                            <span style="color:#4ade80; font-weight:700;">@cSummary.PresentCount Present (@cSummary.PresentPercentage%)</span>
                            &nbsp;|&nbsp;
                            <span style="color:#f87171; font-weight:700;">@cSummary.AbsentCount Absent (@cSummary.AbsentPercentage%)</span>
                        </span>
                    </div>
                    <div style="height:14px; border-radius:999px; background:rgba(239,68,68,.35); overflow:hidden; display:flex;">
                        <div style="width:@cSummary.PresentPercentage%; background:linear-gradient(90deg, #0ea5e9, #22c55e); border-radius:999px 0 0 999px;"></div>
                    </div>
                </div>

                <!-- Student Roll Call List -->
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.85rem;">
                    <div style="font-weight:700; font-size:1rem; color:#e2e8f0;">
                        Student Roll-Call Sheet (@cSummary.Date.ToString("dd MMM yyyy"))
                    </div>
                </div>

                @if (!cSummary.Students.Any())
                {
                    <div style="text-align:center; padding:2rem; color:#94a3b8;">
                        No students found for the selected department/year.
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Student</th>
                                    <th>Roll No</th>
                                    <th>Class / Year</th>
                                    <th>Status</th>
                                    <th>Time Marked</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int idx = 1; }
                                @foreach (var s in cSummary.Students)
                                {
                                    <tr>
                                        <td style="color:#94a3b8;">@(idx++)</td>
                                        <td>
                                            <div style="display:flex; align-items:center; gap:10px;">
                                                @if (!string.IsNullOrEmpty(s.PhotoBase64))
                                                {
                                                    <img src="data:image/jpeg;base64,@s.PhotoBase64" alt="@s.FullName"
                                                         style="width:36px; height:36px; border-radius:50%; object-fit:cover;" />
                                                }
                                                else
                                                {
                                                    <div style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,.08); display:flex; align-items:center; justify-content:center; font-size:1rem;">
                                                        &#128100;
                                                    </div>
                                                }
                                                <span style="font-weight:600;">@s.FullName</span>
                                            </div>
                                        </td>
                                        <td><span class="badge badge-primary">@s.PRN</span></td>
                                        <td style="color:#94a3b8;">@s.Department (Yr @s.Year)</td>
                                        <td>
                                            @if (s.IsPresent)
                                            {
                                                <span class="badge badge-success">&#10004; Present</span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background:rgba(239,68,68,.15); color:#f87171;">&#10007; Absent</span>
                                            }
                                        </td>
                                        <td style="color:#94a3b8; font-size:.85rem;">@s.MarkedTime</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    }

</div>
