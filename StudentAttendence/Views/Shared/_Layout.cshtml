<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Student Attendance System</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --primary:      #6c63ff;
            --primary-dark: #574fd6;
            --secondary:    #0ea5e9;
            --success:      #22c55e;
            --warning:      #f59e0b;
            --danger:       #ef4444;
            --bg:           #0f0f1a;
            --surface:      #1a1a2e;
            --surface2:     #16213e;
            --border:       rgba(255,255,255,0.08);
            --text:         #e2e8f0;
            --muted:        #94a3b8;
            --radius:       14px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        /* ---- NAVBAR ---- */
        nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
            height: 64px;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(12px);
        }
        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            font-weight: 700;
            font-size: 1.1rem;
            color: var(--text);
        }
        .nav-brand-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }
        .nav-links {
            display: flex;
            gap: 8px;
            list-style: none;
        }
        .nav-links a {
            text-decoration: none;
            color: var(--muted);
            font-size: .875rem;
            font-weight: 500;
            padding: 6px 14px;
            border-radius: 8px;
            transition: all .2s;
        }
        .nav-links a:hover {
            color: var(--text);
            background: rgba(255,255,255,.06);
        }
        .nav-links a.active {
            color: var(--primary);
            background: rgba(108,99,255,.12);
        }

        /* ---- MAIN WRAPPER ---- */
        main {
            max-width: 960px;
            margin: 0 auto;
            padding: 2.5rem 1.5rem;
        }

        /* ---- CARDS ---- */
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 2rem;
            margin-bottom: 1.5rem;
        }
        .card-header {
            margin-bottom: 1.5rem;
        }
        .card-title {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: .35rem;
        }
        .card-subtitle {
            color: var(--muted);
            font-size: .875rem;
        }

        /* ---- ALERTS ---- */
        .alert {
            padding: .9rem 1.2rem;
            border-radius: 10px;
            font-size: .875rem;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: fadeIn .3s ease;
        }
        .alert-success { background: rgba(34,197,94,.12); border: 1px solid rgba(34,197,94,.3); color: #4ade80; }
        .alert-danger  { background: rgba(239,68,68,.12);  border: 1px solid rgba(239,68,68,.3);  color: #f87171; }
        .alert-warning { background: rgba(245,158,11,.12); border: 1px solid rgba(245,158,11,.3); color: #fbbf24; }

        /* ---- FORM ELEMENTS ---- */
        .form-group {
            margin-bottom: 1.25rem;
        }
        label {
            display: block;
            font-size: .8rem;
            font-weight: 600;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .04em;
            margin-bottom: .45rem;
        }
        input[type=text], input[type=email], input[type=number], select, textarea {
            width: 100%;
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: .75rem 1rem;
            color: var(--text);
            font-family: 'Inter', sans-serif;
            font-size: .95rem;
            transition: border-color .2s, box-shadow .2s;
            outline: none;
        }
        input:focus, select:focus, textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(108,99,255,.15);
        }
        input::placeholder { color: var(--muted); }
        select option { background: var(--surface2); }

        .field-validation-error {
            color: #f87171;
            font-size: .78rem;
            margin-top: .35rem;
            display: block;
        }
        .input-validation-error {
            border-color: var(--danger) !important;
        }

        /* ---- BUTTONS ---- */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: .75rem 1.5rem;
            border-radius: 10px;
            font-family: 'Inter', sans-serif;
            font-size: .9rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all .2s;
            text-decoration: none;
        }
        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: #fff;
            box-shadow: 0 4px 14px rgba(108,99,255,.35);
        }
        .btn-primary:hover  { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(108,99,255,.45); }
        .btn-primary:active { transform: translateY(0); }

        .btn-secondary {
            background: linear-gradient(135deg, var(--secondary), #0284c7);
            color: #fff;
            box-shadow: 0 4px 14px rgba(14,165,233,.35);
        }
        .btn-secondary:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(14,165,233,.45); }

        .btn-success {
            background: linear-gradient(135deg, var(--success), #16a34a);
            color: #fff;
            box-shadow: 0 4px 14px rgba(34,197,94,.3);
        }
        .btn-success:hover { transform: translateY(-1px); }

        .btn-outline {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--muted);
        }
        .btn-outline:hover { border-color: var(--primary); color: var(--primary); }

        .btn-lg { padding: 1rem 2.2rem; font-size: 1rem; border-radius: 12px; }
        .btn-sm { padding: .45rem 1rem; font-size: .8rem; }

        /* ---- GRID ---- */
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
        @@@@media (max-width: 640px) { .grid-2 { grid-template-columns: 1fr; } }

        /* ---- TABLE ---- */
        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: .875rem; }
        th {
            text-align: left;
            padding: .75rem 1rem;
            color: var(--muted);
            font-size: .75rem;
            text-transform: uppercase;
            letter-spacing: .05em;
            border-bottom: 1px solid var(--border);
        }
        td {
            padding: .85rem 1rem;
            border-bottom: 1px solid var(--border);
            color: var(--text);
        }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: rgba(255,255,255,.02); }

        /* ---- BADGE ---- */
        .badge {
            display: inline-flex;
            align-items: center;
            padding: .25rem .7rem;
            border-radius: 999px;
            font-size: .72rem;
            font-weight: 600;
        }
        .badge-success { background: rgba(34,197,94,.15); color: #4ade80; }
        .badge-primary { background: rgba(108,99,255,.15); color: #a78bfa; }

        /* ---- MISC ---- */
        .text-muted { color: var(--muted); }
        .text-center { text-align: center; }
        .mt-1 { margin-top: .5rem; }
        .mt-2 { margin-top: 1rem; }
        .mt-3 { margin-top: 1.5rem; }
        .flex { display: flex; }
        .gap-2 { gap: 1rem; }
        .items-center { align-items: center; }

        @@keyframes fadeIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
    </style>
</head>
<body>

<nav>
    <ul class="nav-links">
        <li><a href="@Url.Action("Index","Home")"       id="nav-home">Home</a></li>
        <li><a href="@Url.Action("Register","Student")" id="nav-register">Register</a></li>
        <li><a href="@Url.Action("Mark","Attendance")"  id="nav-mark">Mark Attendance</a></li>
        <li><a href="@Url.Action("Report","Attendance")" id="nav-report">Report</a></li>
        <li><a href="@Url.Action("List","Student")"     id="nav-students">Students</a></li>
    </ul>
</nav>

<main>
    @RenderBody()
</main>

<script>
    // Highlight active nav link
    (function () {
        var path = window.location.pathname.toLowerCase();
        var map = {
            '/home/index': 'nav-home', '/': 'nav-home',
            '/student/register': 'nav-register',
            '/attendance/mark': 'nav-mark',
            '/attendance/report': 'nav-report',
            '/student/list': 'nav-students',
            '/attendance/confirm': 'nav-mark'
        };
        for (var key in map) {
            if (path.startsWith(key)) {
                var el = document.getElementById(map[key]);
                if (el) el.classList.add('active');
                break;
            }
        }
    })();
</script>

@RenderSection("scripts", required: false)
</body>
</html>
