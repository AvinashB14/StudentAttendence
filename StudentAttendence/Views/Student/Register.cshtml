    var streamSelect = document.getElementById('streamSelect');
    var deptSelect   = document.getElementById('deptSelect');
    var yearSelect   = document.getElementById('Year');
    var finalDeptInput = document.getElementById('FinalDepartmentInput');
    var summaryBox   = document.getElementById('selectionSummaryBox');
    var summaryText  = document.getElementById('summaryText');
    var removeClassDept = document.getElementById('removeClassDept');

    // Populate Modal delete class dropdown
    if (removeClassDept) {
        removeClassDept.innerHTML = '<option value="">-- Select Department --</option>';
        Object.keys(STREAM_DATA).forEach(function (sKey) {
            var grp = document.createElement('optgroup');
            grp.label = sKey + " Stream";
            var depts = STREAM_DATA[sKey].depts;
            Object.keys(depts).forEach(function (dName) {
                var mOpt = document.createElement('option');
                mOpt.value = sKey + " - " + dName;
                mOpt.textContent = sKey + " - " + dName;
                grp.appendChild(mOpt);
            });
            removeClassDept.appendChild(grp);
        });
    }

    // Helper to update the final composite department string for EF Model
    function updateFinalDepartment() {
        var s = streamSelect.value;
        var d = deptSelect.value;
        var y = yearSelect.value;

        if (s && d) {
            finalDeptInput.value = s + " - " + d;
        } else {
            finalDeptInput.value = "";
        }

        if (s && d && y) {
            summaryText.textContent = s + " > " + d + " > Year " + y;
            summaryBox.style.display = 'block';
        } else {
            summaryBox.style.display = 'none';
        }
    }

    // ── 1. STREAM CHANGE -> Populates DEPARTMENTS ──
    streamSelect.addEventListener('change', function () {
        var stream = this.value;

        // Reset lower cascade levels
        deptSelect.innerHTML = '<option value="">-- Select Department --</option>';
        yearSelect.value = '';
        yearSelect.disabled = true;
        deptSelect.disabled = true;

        if (!stream || !STREAM_DATA[stream]) {
            deptSelect.innerHTML = '<option value="">-- Choose Stream First --</option>';
            updateFinalDepartment();
            return;
        }

        var deptObj = STREAM_DATA[stream].depts;
        Object.keys(deptObj).forEach(function (deptName) {
            var opt = document.createElement('option');
            opt.value = deptName;
            opt.textContent = deptName;
            deptSelect.appendChild(opt);
        });

        deptSelect.disabled = false;
        updateFinalDepartment();
    });

    // ── 2. DEPARTMENT CHANGE -> Enables YEAR ──
    deptSelect.addEventListener('change', function () {
        var dept = this.value;
        yearSelect.value = '';

        if (dept) {
            yearSelect.disabled = false;
        } else {
            yearSelect.disabled = true;
        }
        updateFinalDepartment();
    });

    // ── 3. YEAR CHANGE -> Updates Summary ──
    yearSelect.addEventListener('change', function () {
        updateFinalDepartment();
    });

    // Form submit guard
    var regForm = document.getElementById('registerForm');
    if (regForm) {
        regForm.addEventListener('submit', function (e) {
            updateFinalDepartment();
            if (!finalDeptInput.value) {
                alert('Please complete all 3 academic steps: Stream, Department, and Year.');
                e.preventDefault();
                return false;
            }
        });
    }

})();
