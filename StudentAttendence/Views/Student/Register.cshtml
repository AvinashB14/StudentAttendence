    var successPopupModal  = document.getElementById('successPopupModal');
    var successPopupText   = document.getElementById('successPopupText');
    var modalAlert         = document.getElementById('modalAlert');
    var tabByPrn           = document.getElementById('tabByPrn');
    var tabByClass         = document.getElementById('tabByClass');
    var formPrnSection     = document.getElementById('formPrnSection');
    var formClassSection   = document.getElementById('formClassSection');
    var csrfToken          = (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value || '';

    // Open & Close Modal
    document.getElementById('btnOpenRemoveModal').addEventListener('click', function () {
        hideModalAlert();
        removeModal.style.display = 'flex';
    });

    document.getElementById('btnCloseRemoveModal').addEventListener('click', function () {
        removeModal.style.display = 'none';
    });

    document.querySelectorAll('.btnCancelModal').forEach(function (btn) {
        btn.addEventListener('click', function () {
            removeModal.style.display = 'none';
        });
    });

    document.getElementById('btnCloseSuccessPopup').addEventListener('click', function () {
        successPopupModal.style.display = 'none';
        window.location.reload();
    });

    // Tab switching inside modal
    tabByPrn.addEventListener('click', function () {
        tabByPrn.style.background = '#ef4444';
        tabByPrn.style.color = '#fff';
        tabByClass.style.background = 'transparent';
        tabByClass.style.color = '#94a3b8';
        formPrnSection.style.display = 'block';
        formClassSection.style.display = 'none';
        hideModalAlert();
    });

    tabByClass.addEventListener('click', function () {
        tabByClass.style.background = '#ef4444';
        tabByClass.style.color = '#fff';
        tabByPrn.style.background = 'transparent';
        tabByPrn.style.color = '#94a3b8';
        formPrnSection.style.display = 'none';
        formClassSection.style.display = 'block';
        hideModalAlert();
    });

    function showModalAlert(msg, isSuccess) {
        modalAlert.style.display = 'block';
        modalAlert.style.background = isSuccess ? 'rgba(34,197,94,.15)' : 'rgba(239,68,68,.15)';
        modalAlert.style.border = isSuccess ? '1px solid rgba(34,197,94,.4)' : '1px solid rgba(239,68,68,.4)';
        modalAlert.style.color = isSuccess ? '#4ade80' : '#f87171';
        modalAlert.textContent = msg;
    }

    function hideModalAlert() {
        modalAlert.style.display = 'none';
    }

    function triggerSuccessPopup(msg) {
        removeModal.style.display = 'none';
        successPopupText.textContent = msg;
        successPopupModal.style.display = 'flex';
    }

    // 1. Delete Student by Roll No
    document.getElementById('btnConfirmDeletePrn').addEventListener('click', function () {
        var prn = (document.getElementById('removePrnInput').value || '').trim();
        if (!prn) {
            showModalAlert('Please enter the student Roll Number.', false);
            return;
        }

        if (!confirm('Are you sure you want to permanently delete student with Roll No "' + prn + '"?')) {
            return;
        }

        var btn = this;
        btn.disabled = true;
        btn.textContent = 'Removing...';
        hideModalAlert();

        var formData = new FormData();
        formData.append('__RequestVerificationToken', csrfToken);
        formData.append('prn', prn);

        fetch('@Url.Action("RemoveByPrn", "Student")', {
            method: 'POST',
            body: formData
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            btn.disabled = false;
            btn.innerHTML = '&#128465; Delete This Student';
            if (data.success) {
                triggerSuccessPopup(data.message);
            } else {
                showModalAlert(data.message || 'Could not remove student.', false);
            }
        })
        .catch(function (err) {
            btn.disabled = false;
            btn.innerHTML = '&#128465; Delete This Student';
            showModalAlert('Error: ' + err.message, false);
        });
    });

    // 2. Delete Class Students
    document.getElementById('btnConfirmDeleteClass').addEventListener('click', function () {
        var dept = (document.getElementById('removeClassDept').value || '').trim();
        var year = document.getElementById('removeClassYear').value;

        if (!dept) {
            showModalAlert('Please select a Department from the list.', false);
            return;
        }
        if (!year) {
            showModalAlert('Please select Class Year.', false);
            return;
        }

        if (!confirm('Are you sure you want to delete ALL students belonging to ' + dept + ' (Year ' + year + ')? This action cannot be undone.')) {
            return;
        }

        var btn = this;
        btn.disabled = true;
        btn.textContent = 'Removing class...';
        hideModalAlert();

        var formData = new FormData();
        formData.append('__RequestVerificationToken', csrfToken);
        formData.append('department', dept);
        formData.append('year', year);

        fetch('@Url.Action("RemoveClass", "Student")', {
            method: 'POST',
            body: formData
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            btn.disabled = false;
            btn.innerHTML = '&#128465; Delete Entire Class';
            if (data.success) {
                triggerSuccessPopup(data.message);
            } else {
                showModalAlert(data.message || 'Could not remove class.', false);
            }
        })
        .catch(function (err) {
            btn.disabled = false;
            btn.innerHTML = '&#128465; Delete Entire Class';
            showModalAlert('Error: ' + err.message, false);
        });
    });

